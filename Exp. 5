#client

#include <stdio.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <string.h>
#include <arpa/inet.h>
#include <unistd.h>

int main()
{
    int client;
    char buffer[1024];
    struct sockaddr_in servAddr;
    int n;

    client = socket(AF_INET, SOCK_STREAM, 0);
    servAddr.sin_family = AF_INET;
    servAddr.sin_port = htons(6265);
    servAddr.sin_addr.s_addr = inet_addr("127.0.0.1");
    memset(servAddr.sin_zero, 0, sizeof(servAddr.sin_zero));

    if (connect(client, (struct sockaddr *)&servAddr, sizeof(servAddr)) < 0) {
        perror("connect");
        return 1;
    }

    printf("Sending Data to server\n");
    strcpy(buffer, "Hi This is a client\n");
    send(client, buffer, strlen(buffer), 0);

    n = recv(client, buffer, sizeof(buffer) - 1, 0);
    if (n > 0) {
        buffer[n] = '\0';
        printf("Data received: %s", buffer);
    }

    close(client);
    return 0;
}


#server


#include <stdio.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <string.h>
#include <arpa/inet.h>
#include <unistd.h>

int main()
{
    int server, newSock;
    char buffer[1024];
    struct sockaddr_in servAddr;
    struct sockaddr_storage store;
    socklen_t addrSize = sizeof(store);   /* must be initialised */
    int n;

    server = socket(AF_INET, SOCK_STREAM, 0);
    servAddr.sin_family = AF_INET;
    servAddr.sin_port = htons(6265);
    servAddr.sin_addr.s_addr = inet_addr("127.0.0.1");
    memset(servAddr.sin_zero, 0, sizeof(servAddr.sin_zero));

    if (bind(server, (struct sockaddr *)&servAddr, sizeof(servAddr)) < 0) {
        perror("bind");
        return 1;
    }

    if (listen(server, 5) == 0)
        printf("Listening\n");
    else {
        printf("Error\n");
        return 1;
    }

    newSock = accept(server, (struct sockaddr *)&store, &addrSize);

    n = recv(newSock, buffer, sizeof(buffer) - 1, 0);
    if (n > 0) {
        buffer[n] = '\0';
        printf("Data received: %s", buffer);
    }

    strcpy(buffer, "hi this is server\n");
    send(newSock, buffer, strlen(buffer), 0);

    close(newSock);
    close(server);
    return 0;
}
